# Copy to .env and adjust. The backend reads these on startup.

# Required in production: a long random string used to sign access tokens.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Token lifetime in minutes (default 12 hours)
JWT_EXPIRE_MINUTES=720

# Require a bearer token on case, history, report and overlay endpoints
AUTH_REQUIRED=true

# Allow readers to create their own accounts from the sign-in page
ALLOW_REGISTRATION=true

# Seed the documented demo reader (reader@medgraph.dev / radiology).
# Set to false for any deployment that holds real data.
SEED_DEMO_USER=true

DATABASE_URL=sqlite+aiosqlite:///./medgraph.db
